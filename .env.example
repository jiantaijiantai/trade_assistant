# trade_assistant local environment example.
# Copy this file to .env and fill in local values only when model-backed features are enabled.

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen3.6-plus
EMBEDDING_MODEL=qwen2.5-vl-embedding

# Runtime behavior
APP_ENV=local
LOG_LEVEL=INFO
ALLOW_WRITE_TOOLS=false

EMBEDDING_PROVIDER=local_hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen2.5-vl-embedding
EMBEDDING_DIM=512
